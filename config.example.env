# shellcheck disable=SC2034
# Values here are read by watch.py; the shell only sources them.
#
# After an upgrade, merge new options into an existing config without
# losing values:
#   python3 watch.py merge-config
# or, after a package install:
#   opencode-spend-watch merge-config

# Mattermost channel for the alerts.
# Create an Incoming Webhook in Mattermost:
#   Integrations > Incoming Webhooks > Add
# Paste the full URL below, inside quotes if it contains & ? or #.
# Keep this file mode 600. It is git-ignored.
MATTERMOST_WEBHOOK_URL=""

# Optional additional channels. Leave a block empty to disable it.
# Slack incoming webhook:
SLACK_WEBHOOK_URL=""
# Discord webhook:
DISCORD_WEBHOOK_URL=""
# IRC:
IRC_HOST=""
IRC_PORT=6697
IRC_TLS=true
IRC_NICK="opencode-spend"
IRC_CHANNEL="#alerts"
IRC_PASSWORD=""
# Email over SMTP (starttls, ssl, or none):
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""
EMAIL_TO=""
# WhatsApp Cloud API:
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TO=""
WHATSAPP_API_VERSION="v21.0"

# Telegram bot (create one with @BotFather, then get the chat id):
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Desktop notification: notify-send on Linux, osascript on macOS.
DESKTOP_NOTIFY=false

# Alert when a usage window crosses these percentages (comma-separated):
PERCENT_THRESHOLDS=50,80,95

# RSS 2.0 feed of alerts. Leave empty to disable.
RSS_FEED=""
RSS_TITLE="OpenCode Spend Alerts"
RSS_LINK=""
RSS_MAX_ITEMS=100

# JSONL alert log. Default: STATE_DIR/alerts.log
# ALERT_LOG=~/.local/state/opencode-spend-watch/alerts.log

# Extra cost providers: opencode, openrouter, openai.
PROVIDERS=opencode
OPENROUTER_API_KEY=""
# 0 means use the purchased credit total as the budget.
OPENROUTER_BUDGET_USD=0
OPENAI_ADMIN_KEY=""
OPENAI_ORG_ID=""
OPENAI_BUDGET_USD=0

# OpenCode plan: go-plus (default) or go.
PLAN=go-plus

# Alert every time spend crosses this many dollars (all providers).
THRESHOLD_STEP_USD=1

# Minutes between cron checks. Integer from 1 to 59.
CRON_INTERVAL_MINUTES=15

# Where the daily history and alert state live.
STATE_DIR=~/.local/state/opencode-spend-watch

# OpenCode's local database. The Go key is read from it, never printed.
OPENCODE_DB=~/.local/share/opencode/opencode.db

# Optional: abort if the key is not in the database.
# OPENCODE_GO_KEY=oc_...

# Optional link included at the bottom of every alert, for example:
# CONSOLE_URL="https://opencode.ai/console/<org-id>/activity/overview?range=30d"
CONSOLE_URL=""

# Send one message when the watcher first runs.
STARTUP_MESSAGE=true

# Send one message when the billing period resets.
RESET_MESSAGE=true

# Optional overrides.
# LIMITS_FILE=/path/to/limits.json
