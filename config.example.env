# shellcheck disable=SC2034
# Values here are read by watch.py; the shell only sources them.

# Mattermost channel for the alerts.
# Create an Incoming Webhook in Mattermost:
#   Integrations > Incoming Webhooks > Add
# Paste the full URL below, inside quotes if it contains & ? or #.
# Keep this file mode 600. It is git-ignored.
MATTERMOST_WEBHOOK_URL=""

# OpenCode plan: go-plus (default) or go.
PLAN=go-plus

# Alert every time spend crosses this many dollars.
THRESHOLD_STEP_USD=1

# Where the daily history and alert state live.
STATE_DIR=~/.local/state/opencode-spend-watch

# OpenCode's local database. The Go key is read from it, never printed.
OPENCODE_DB=~/.local/share/opencode/opencode.db

# Optional: abort if the key is not in the database.
# OPENCODE_GO_KEY=oc_...

# Optional link included at the bottom of every alert, for example:
# CONSOLE_URL="https://opencode.ai/console/<org-id>/activity/overview?range=30d"
CONSOLE_URL=""

# Send one message when the watcher first runs.
STARTUP_MESSAGE=true

# Send one message when the billing period resets.
RESET_MESSAGE=true

# Optional overrides.
# LIMITS_FILE=/path/to/limits.json
